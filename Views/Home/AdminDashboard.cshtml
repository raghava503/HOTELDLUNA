
@model WebApplication7.Controllers.AdminDashboardViewModel


@{
    ViewBag.Title = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>
<ul class="list-group">
    <li class="list-group-item">Total Bookings: <strong>@Model.TotalBookings</strong></li>
    <li class="list-group-item">Occupied Rooms: <strong>@Model.OccupiedRooms</strong></li>
    <li class="list-group-item">Total Revenue: <strong>@Model.TotalRevenue.ToString("C")</strong></li>
</ul>
<h4>Customer Bookings</h4>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>Booking ID</th>
                <th>Username</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Bill</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.Username</td>
                    <td>@booking.CheckIn.ToShortDateString()</td>
                    <td>@booking.CheckOut.ToShortDateString()</td>
                    <td>@booking.Bill.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>